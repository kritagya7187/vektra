# VEKTRA Backend — environment variables this service consumes.
#
# See the repository-root .env.example for the full monorepo-wide list.
# CESIUM_ION_TOKEN and TOMTOM_API_KEY are deliberately absent here — those
# belong to the frontend (EDD Section 12, 20, 33), this service never
# reads them.
#
# API_AUTH_SECRET is also deliberately absent. Authentication/authorization
# is "Not specified" in EDD Section 23. Per project constraint, this phase
# must not consume or enforce it — it will be added here only when an
# authentication model is explicitly designed in a future phase.

NODE_ENV=development

# --- Server ---
BACKEND_PORT=3000

# --- Database ---
# Must be a login role granted membership in vektra_backend_api
# (see db/migrations/0014_roles_and_grants.sql) — never a superuser
# or the ingestion/simulation roles.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vektra
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- CORS (Section 33: "restricted to known frontend origins") ---
# Comma-separated allowlist, e.g. http://localhost:5173,https://vektra.example.com
# Leave empty to deny all cross-origin requests (secure default).
CORS_ALLOWED_ORIGINS=

# --- Rate limiting ---
# Disabled by default in development. If enabled, both threshold values
# below are required — no default threshold is assumed or hard-coded
# (see backend/src/config/env.schema.ts).
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=

# --- Logging ---
LOG_LEVEL=info

# --- Remote Sensing (Phase 3 Milestone 2) ---
# Copernicus Data Space Ecosystem OAuth2 client (dashboard -> OAuth
# Clients). Powers Sentinel-2 and Landsat ingestion. Only required by
# `npm run ingest:raster -- --source=sentinel2_l2a` / `landsat_c2_l2`,
# never by the HTTP server.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# OpenTopography account API key. Powers SRTM DEM ingestion.
OPENTOPOGRAPHY_API_KEY=

# USGS EROS M2M API — an independently-credentialed Landsat access path
# (ers.cr.usgs.gov, "Create Application Token", scope "M2M API").
# USGS_EROS_TOKEN is that application token, never the account password.
# Confirmed live: login-token exchange and scene-search both work; the
# download-options step is currently blocked by a separate USGS access
# tier (see usgsM2mSceneSearch.ts). Only required by
# `npm run ingest:raster -- --source=landsat_c2_l2` if that path is used
# instead of/alongside the Copernicus one above.
USGS_EROS_USERNAME=
USGS_EROS_TOKEN=

# Directory downloaded raster files are written to (no default — see
# rasterStorage.ts's own note on why a storage location must always be
# explicit, never assumed). Only required by
# `npm run ingest:raster -- --source=...`.
RASTER_STORAGE_DIR=
