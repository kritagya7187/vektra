{
  "name": "vektra-backend",
  "version": "0.1.0",
  "private": true,
  "description": "VEKTRA Backend API Layer — REST API mediating all access to the PostGIS canonical/derived storage layer.",
  "main": "dist/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "ingest:osm": "node dist/ingestion/runOsmIngestion.js",
    "ingest:osm:dev": "tsx src/ingestion/runOsmIngestion.ts",
    "ingest:raster": "node dist/ingestion/runRasterIngestion.js",
    "ingest:raster:dev": "tsx src/ingestion/runRasterIngestion.ts",
    "ingest:meteo": "node dist/ingestion/runMeteorologicalIngestion.js",
    "ingest:meteo:dev": "tsx src/ingestion/runMeteorologicalIngestion.ts",
    "verify:gee-auth": "node dist/ingestion/remoteSensing/gee/verifyGeeAuth.js",
    "verify:gee-auth:dev": "tsx src/ingestion/remoteSensing/gee/verifyGeeAuth.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test": "npm run test:unit && npm run test:integration",
    "test:coverage": "vitest run --config vitest.config.ts --coverage && vitest run --config vitest.integration.config.ts --coverage"
  },
  "dependencies": {
    "@google/earthengine": "^1.7.37",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "geotiff": "^3.0.5",
    "helmet": "^8.0.0",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vitest": "^4.1.10"
  }
}
