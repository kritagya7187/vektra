# --- Database (PostgreSQL + PostGIS) — Section 12, 16 ---
# POSTGRES_HOST/PORT below are for the backend running OUTSIDE Docker
# (npm run dev). Inside docker-compose, the backend is given
# POSTGRES_HOST=db automatically (docker-compose.yml) — never localhost
# inside a container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vektra
# Must be a login role granted membership in vektra_backend_api
# (see db/migrations/0014_roles_and_grants.sql) — never a superuser or
# the ingestion/simulation roles. In docker-compose, this exact
# name/password pair is what db/docker/03-create-app-role.sh provisions
# on first startup.
#
# MUST NOT be "postgres" (discovered during Phase 2H real verification,
# not a hypothetical concern): the official postgres/postgis image always
# provisions its own bootstrap superuser role named "postgres" by default
# (docker-compose.yml deliberately never overrides that image's own
# POSTGRES_USER — see its header comment). If this value is also
# "postgres", 03-create-app-role.sh's `IF NOT EXISTS` guard finds that
# role already exists (as the superuser) and skips creating it, silently
# leaving NO login role with this password — the backend then fails to
# authenticate with "password authentication failed for user postgres"
# even though every value here looks individually correct. Any name
# distinct from "postgres" avoids this collision.
POSTGRES_USER=vektra_backend
POSTGRES_PASSWORD=
# docker-compose ONLY: bootstraps the db container's own Postgres
# superuser (used solely during first-startup schema/role
# initialization). Deliberately separate from POSTGRES_USER/PASSWORD
# above — see docker-compose.yml's own header comment for why those two
# can't safely double as this value.
POSTGRES_SUPERUSER_PASSWORD=

# --- Backend API — Section 23 ---
BACKEND_PORT=3000
LOG_LEVEL=info
# Auth approach is "Not specified" in the EDD (Section 23).
# Placeholder for a shared credential / session secret pending decision.
API_AUTH_SECRET=

# Disabled by default (docker-compose.yml's own `${RATE_LIMIT_ENABLED:-false}`
# already falls back to this same value if unset — declared explicitly
# here anyway so this file stays the complete list of every variable
# docker-compose.yml references, per Phase 2I's environment-variable
# consistency check). If set to true, RATE_LIMIT_WINDOW_MS and
# RATE_LIMIT_MAX_REQUESTS must ALSO be added here explicitly — they are
# deliberately not listed with defaults; see docker-compose.yml's own
# comment on the env.schema.ts empty-string-coercion issue this avoids.
RATE_LIMIT_ENABLED=false

# CORS (Section 33: "restricted to known frontend origins"). Empty means
# deny all cross-origin requests (backend/src/middleware/corsOptions.ts's
# secure default). For docker-compose specifically, this must name the
# ORIGIN A BROWSER ACTUALLY LOADS THE FRONTEND FROM — i.e.
# http://localhost:${FRONTEND_PORT} below, not any container-internal
# name — because CORS is enforced against the browser's Origin header,
# not container-to-container traffic. Comma-separated for more than one.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- Frontend — Phase 2H — Section 12, 20, 22 ---
# Published host port for the static frontend container (Docker &
# Deployment engineering review, item 7/12: a static build served by a
# lightweight web server, no SSR/reverse proxy required). Must match the
# port named in CORS_ALLOWED_ORIGINS above.
FRONTEND_PORT=8080

# Baked into the frontend's static JS bundle at BUILD time (Vite only
# exposes VITE_-prefixed vars, and does so at `vite build` time, not
# container start time — see frontend/Dockerfile). This must be a URL
# the END USER'S BROWSER can reach, i.e. the backend's host-published
# port, never a container-internal DNS name like "backend".
VITE_API_BASE_URL=http://localhost:3000

# MapLibre style JSON URL. Optional — frontend/src/config.ts defaults to
# a free, no-key OpenFreeMap style if left blank.
VITE_MAP_STYLE_URL=

# Raster-DEM terrain tile URL template ({z}/{x}/{y}), Terrarium-encoded.
# Optional — defaults to AWS's free public Terrarium tiles if left blank.
VITE_TERRAIN_TILE_URL=

# Google Maps Platform API key with the Map Tiles API enabled, for
# Google Photorealistic 3D Tiles (Step 20). Optional — the viewer renders
# terrain/imagery/flood layers normally without it, just without
# photorealistic buildings. Get one from a Google Cloud project with
# billing enabled; this is not a VEKTRA-issued credential.
VITE_GOOGLE_3D_TILES_API_KEY=

# Base URL of the flood-engine FastAPI service (Step 15/19), consumed
# by the BACKEND (backend/src/floodEngine/client.ts), never the browser
# directly. Optional at the schema level, required at point of use —
# any flood-simulation request fails fast with a clear message if unset.
# flood-engine itself is not wired into docker-compose.yml yet (Step 20
# freeze audit, known limitation); if you're running it on the Docker
# host outside this compose file, use host.docker.internal, e.g.
# http://host.docker.internal:8000 — never localhost from inside the
# backend container.
FLOOD_ENGINE_BASE_URL=

# --- TomTom Developer APIs (optional) — Section 8, 13, 33 ---
TOMTOM_API_KEY=

# --- Remote Sensing (Phase 3 Milestone 2; primary provider changed to
# Google Earth Engine in the Remote Sensing Strategy Change) ---
# CLI-only — never consumed by the HTTP server. Documented here anyway so
# this file stays a complete list of every variable the backend's
# ingestion CLI entry points can consume, matching backend/.env.example.
#
# Google Earth Engine — the PRIMARY acquisition provider for all 4 raster
# sources plus the optional ERA5-Land meteorological source.
# GOOGLE_APPLICATION_CREDENTIALS here is only consumed for `npm run dev`
# outside Docker — inside docker-compose the backend container gets the
# key via a read-only bind mount of backend/secrets/ instead
# (docker-compose.yml's own comment), so this value is irrelevant to the
# container itself, only GOOGLE_CLOUD_PROJECT_ID below (which
# docker-compose DOES pass through via env_file).
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT_ID=

# Direct-provider credentials — DORMANT FALLBACKS only (see
# backend/src/ingestion/runRasterIngestion.ts's factory-map comment).
# ESA WorldCover's own fallback needs no credential (public AWS S3).
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
OPENTOPOGRAPHY_API_KEY=

# Directory downloaded raster files are written to — no default; see
# backend/src/ingestion/remoteSensing/rasterStorage.ts's own note on why
# a storage location must always be explicit, never assumed.
RASTER_STORAGE_DIR=

# Google Photorealistic 3D Tiles API key (optional)
VITE_GOOGLE=
