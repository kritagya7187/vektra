# --- Database (PostgreSQL + PostGIS) — Section 12, 16 ---
# POSTGRES_HOST/PORT below are for the backend running OUTSIDE Docker
# (npm run dev). Inside docker-compose, the backend is given
# POSTGRES_HOST=db automatically (docker-compose.yml) — never localhost
# inside a container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vektra
# Must be a login role granted membership in vektra_backend_api
# (see db/migrations/0014_roles_and_grants.sql) — never a superuser or
# the ingestion/simulation roles. In docker-compose, this exact
# name/password pair is what db/docker/03-create-app-role.sh provisions
# on first startup.
POSTGRES_USER=
POSTGRES_PASSWORD=
# docker-compose ONLY: bootstraps the db container's own Postgres
# superuser (used solely during first-startup schema/role
# initialization). Deliberately separate from POSTGRES_USER/PASSWORD
# above — see docker-compose.yml's own header comment for why those two
# can't safely double as this value.
POSTGRES_SUPERUSER_PASSWORD=

# --- Backend API — Section 23 ---
BACKEND_PORT=3000
LOG_LEVEL=info
# Auth approach is "Not specified" in the EDD (Section 23).
# Placeholder for a shared credential / session secret pending decision.
API_AUTH_SECRET=

# --- Cesium ion — Section 12, 20, 33 ---
CESIUM_ION_TOKEN=

# --- TomTom Developer APIs (optional) — Section 8, 13, 33 ---
TOMTOM_API_KEY=
