# VEKTRA flood-engine — environment variables this service consumes.
#
# Deployment configuration only (see src/flood_engine/config.py's module
# docstring). Scientific parameters (Manning's n, infiltration, WCA2D
# timestep/stability) are never set here — they live as frozen constants
# in flood_engine.core, changeable only through code review.

# --- Database ---
# Same PostGIS database as the Node backend (backend/.env.example) — this
# service reads/writes SDS Section 7 tables alongside the existing schema,
# not a second database. Reuses the Node backend's exact variable names so
# one shared .env can configure both services; the login role must still
# be one granted membership in vektra_backend_api (see
# db/migrations/0014_roles_and_grants.sql), never a superuser.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vektra
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10

# --- Raster storage (input) ---
# Same variable and meaning as backend/.env.example's RASTER_STORAGE_DIR —
# flood-engine reads the DEM/WorldCover rasters the existing GEE ingestion
# pipeline already wrote there; it does not maintain a second copy.
RASTER_STORAGE_DIR=

# --- Flood output storage ---
# Where per-run summary rasters (max depth, arrival time, duration) are
# written. FLOOD_OUTPUT_RETAIN_FULL_TIMESTEPS controls whether the full
# per-timestep grid sequence is also kept (storage-heavy; see SDS Section 7)
# — false by default, only enabled for deliberately-flagged runs.
FLOOD_OUTPUT_STORAGE_DIR=
FLOOD_OUTPUT_RETAIN_FULL_TIMESTEPS=false

# --- Simulation execution limits (operational only, never scientific) ---
MAX_CONCURRENT_RUNS=2
RUN_TIMEOUT_SECONDS=3600
JOB_POLL_INTERVAL_SECONDS=5.0

# --- Logging ---
LOG_LEVEL=info

# --- API ---
# No CORS setting: this API is called by the Node backend over the
# internal Docker network, never directly by a browser.
HOST=0.0.0.0
PORT=8001
