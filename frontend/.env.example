# VEKTRA Frontend — Visualization Subsystem (EDD Section 12, 20, 33)
#
# Vite only exposes env vars prefixed VITE_ to client code — anything
# without that prefix (e.g. a real backend secret) is never bundled,
# matching Section 33's "never embedded in frontend-shipped code."

# Base URL of the backend REST API (EDD Section 21, 23). No trailing
# slash. Also fronts the flood-simulation proxy routes (Step 20 Part 0b,
# /api/flood-simulations/*) — same Express app, same base URL. Never
# point this at the Python FastAPI service directly.
VITE_API_BASE_URL=http://localhost:3000

# MapLibre style JSON URL. Optional — defaults to a free, no-key
# OpenFreeMap style if left blank.
VITE_MAP_STYLE_URL=

# Raster-DEM terrain tile URL template ({z}/{x}/{y}), Terrarium-encoded.
# Optional — defaults to AWS's free public Terrarium tiles if left blank.
VITE_TERRAIN_TILE_URL=

# Google Maps Platform API key with the Map Tiles API enabled, for
# Google Photorealistic 3D Tiles. Optional — the viewer renders
# terrain/imagery/flood layers normally without it, just without
# photorealistic buildings. Get one from a Google Cloud project with
# billing enabled; this is not a VEKTRA-issued credential.
VITE_GOOGLE_3D_TILES_API_KEY=
