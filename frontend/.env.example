# VEKTRA Frontend — Visualization Subsystem (EDD Section 12, 20, 33)
#
# Vite only exposes env vars prefixed VITE_ to client code — anything
# without that prefix (e.g. a real backend secret) is never bundled,
# matching Section 33's "never embedded in frontend-shipped code."

# Base URL of the backend REST API (EDD Section 21, 23). No trailing slash.
VITE_API_BASE_URL=http://localhost:3000

# Cesium ion access token (EDD Section 12, 20) — provides terrain via
# Cesium World Terrain. Public/scoped token intended for browser use per
# Cesium ion's own token model; not a server secret.
VITE_CESIUM_ION_TOKEN=
