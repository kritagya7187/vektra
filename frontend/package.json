{
  "name": "vektra-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "VEKTRA Visualization Subsystem — CesiumJS + TypeScript digital twin client, consuming the backend REST API only.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "cesium": "^1.121.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vite": "^5.4.10",
    "vite-plugin-cesium": "^1.2.23",
    "vitest": "^2.1.4"
  }
}
