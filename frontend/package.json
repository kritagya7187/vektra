{
  "name": "vektra-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "VEKTRA Visualization Subsystem — MapLibre GL JS + deck.gl + TypeScript digital twin client, consuming the backend REST API only.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "maplibre-gl": "^6.1.0",
    "@deck.gl/core": "^9.3.7",
    "@deck.gl/layers": "^9.3.7",
    "@deck.gl/geo-layers": "^9.3.7",
    "@deck.gl/mapbox": "^9.3.7",
    "@luma.gl/core": "^9.3.3",
    "@loaders.gl/3d-tiles": "^4.4.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
